#!/bin/bash
set -u
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$APP_DIR" || exit 1
LOG="$APP_DIR/temple-launcher.log"
notify(){ /usr/bin/osascript -e "display notification \"$1\" with title \"Temple Escape\"" >/dev/null 2>&1 || true; }
alert(){ /usr/bin/osascript -e "display alert \"Temple Escape\" message \"$1\" as critical" >/dev/null 2>&1 || true; }
if ! command -v node >/dev/null 2>&1; then alert "Node.js was not found. Install Node 18, then double-click the launcher again."; exit 1; fi
if ! command -v npm >/dev/null 2>&1; then alert "npm was not found. Reinstall Node.js 18, then double-click the launcher again."; exit 1; fi
if [ -f .temple-vite.pid ]; then OLD_PID="$(cat .temple-vite.pid 2>/dev/null || true)"; if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then kill "$OLD_PID" 2>/dev/null || true; sleep 1; fi; rm -f .temple-vite.pid; fi
if [ ! -x node_modules/.bin/vite ]; then notify "First launch: preparing the game..."; npm install >>"$LOG" 2>&1; if [ $? -ne 0 ]; then alert "Setup failed. Open temple-launcher.log in the game folder to see the error."; exit 1; fi; fi
notify "Starting Temple Escape..."
nohup npm run dev -- --host 127.0.0.1 >"$LOG" 2>&1 &
PID=$!
echo "$PID" > .temple-vite.pid
URL="http://127.0.0.1:5173/"
for i in $(seq 1 40); do if /usr/bin/curl -fsS "$URL" >/dev/null 2>&1; then /usr/bin/open "$URL"; exit 0; fi; sleep 0.25; done
alert "The game server did not start. Open temple-launcher.log in the game folder for details."
exit 1
